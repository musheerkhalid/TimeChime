<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Light Theme Brushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#F1F5F9" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#F8FAFC" />
    <SolidColorBrush x:Key="BorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#0F172A" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#475569" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#94A3B8" />

    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1E40AF" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#DBEAFE" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#059669" />
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#D1FAE5" />
    <SolidColorBrush x:Key="WarningBrush" Color="#D97706" />
    <SolidColorBrush x:Key="DangerBrush" Color="#DC2626" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#B91C1C" />

    <SolidColorBrush x:Key="TagBackgroundBrush" Color="#EFF6FF" />
    <SolidColorBrush x:Key="TagForegroundBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#CBD5E1" />

    <SolidColorBrush x:Key="SliderTrackBrush" Color="#E2E8F0" />
    <SolidColorBrush x:Key="SliderThumbBrush" Color="#2563EB" />

</ResourceDictionary>

