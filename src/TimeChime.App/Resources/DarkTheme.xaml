<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Dark Theme Brushes -->
    <SolidColorBrush x:Key="WindowBackgroundBrush" Color="#18181B" />
    <SolidColorBrush x:Key="SurfaceBackgroundBrush" Color="#27272A" />
    <SolidColorBrush x:Key="SurfaceHoverBrush" Color="#3F3F46" />
    <SolidColorBrush x:Key="CardBackgroundBrush" Color="#202023" />
    <SolidColorBrush x:Key="CardHoverBrush" Color="#27272A" />
    <SolidColorBrush x:Key="BorderBrush" Color="#3F3F46" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#323238" />
    <SolidColorBrush x:Key="HeaderBackgroundBrush" Color="#1E1E22" />

    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F4F5" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#A1A1AA" />
    <SolidColorBrush x:Key="TextMutedBrush" Color="#71717A" />

    <SolidColorBrush x:Key="AccentBrush" Color="#3B82F6" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#2563EB" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#1D4ED8" />
    <SolidColorBrush x:Key="AccentForegroundBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="AccentSubtleBrush" Color="#1E3A8A" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#10B981" />
    <SolidColorBrush x:Key="SuccessSubtleBrush" Color="#064E3B" />
    <SolidColorBrush x:Key="WarningBrush" Color="#F59E0B" />
    <SolidColorBrush x:Key="DangerBrush" Color="#EF4444" />
    <SolidColorBrush x:Key="DangerHoverBrush" Color="#DC2626" />

    <SolidColorBrush x:Key="TagBackgroundBrush" Color="#374151" />
    <SolidColorBrush x:Key="TagForegroundBrush" Color="#93C5FD" />
    <SolidColorBrush x:Key="InputBackgroundBrush" Color="#1F1F23" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#3F3F46" />

    <SolidColorBrush x:Key="SliderTrackBrush" Color="#3F3F46" />
    <SolidColorBrush x:Key="SliderThumbBrush" Color="#3B82F6" />

</ResourceDictionary>

