<Window x:Class="TimeChime.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:TimeChime.App.ViewModels"
        mc:Ignorable="d"
        Title="Time Chime — Spoken Clock Chime"
        Icon="pack://application:,,,/Resources/app_icon.png"
        Width="860" Height="740" MinWidth="740" MinHeight="580"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif">

    <Grid>
        <Grid.RowDefinitions>
            <!-- Header (Fixed) -->
            <RowDefinition Height="Auto" />
            <!-- Main Scrollable Body -->
            <RowDefinition Height="*" />
            <!-- Footer (Fixed) -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ========================================== -->
        <!-- HEADER -->
        <!-- ========================================== -->
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- App Brand & Title -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Width="40" Height="40" CornerRadius="10" Background="{DynamicResource AccentBrush}" Margin="0,0,14,0" VerticalAlignment="Center">
                        <Path Data="{StaticResource IconBell}" Fill="{DynamicResource AccentForegroundBrush}" Width="20" Height="20" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <StackPanel VerticalAlignment="Center">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Time Chime" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,10,0" />
                            <!-- Status Badge -->
                            <Border CornerRadius="12" Padding="8,2" VerticalAlignment="Center">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="{DynamicResource SuccessSubtleBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding StatusBadgeText}" Value="PAUSED">
                                                <Setter Property="Background" Value="#4B3306" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding StatusBadgeText}" Value="DISABLED">
                                                <Setter Property="Background" Value="#451212" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="{Binding StatusBadgeText}" FontSize="11" FontWeight="Bold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding StatusBadgeText}" Value="PAUSED">
                                                    <Setter Property="Foreground" Value="{DynamicResource WarningBrush}" />
                                                </DataTrigger>
                                                <DataTrigger Binding="{Binding StatusBadgeText}" Value="DISABLED">
                                                    <Setter Property="Foreground" Value="{DynamicResource DangerBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Border>
                        </StackPanel>
                        <TextBlock Text="Offline Spoken Clock Announcements" FontSize="12" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                    </StackPanel>
                </StackPanel>

                <!-- Header Actions (Master Toggle, Pause, Themes) -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Master Toggle -->
                    <CheckBox Style="{StaticResource ToggleSwitch}" IsChecked="{Binding IsEnabled}" ToolTip="Enable or disable all scheduled chimes" VerticalAlignment="Center" Margin="0,0,14,0">
                        <TextBlock Text="Master Chime" FontWeight="SemiBold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" />
                    </CheckBox>

                    <!-- Pause/Resume Button -->
                    <Button Style="{StaticResource SecondaryButton}" Command="{Binding TogglePauseCommand}" Margin="0,0,14,0" ToolTip="Quick pause/resume without resetting schedule">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="{StaticResource IconPause}" Fill="{DynamicResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding PauseButtonText}" />
                        </StackPanel>
                    </Button>

                    <!-- Theme Switcher Buttons -->
                    <Border Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="2">
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding SetThemeCommand}" CommandParameter="dark" BorderThickness="0" Padding="8,4" ToolTip="Switch to Dark Theme">
                                <Path Data="{StaticResource IconMoon}" Fill="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                            </Button>
                            <Button Style="{StaticResource SecondaryButton}" Command="{Binding SetThemeCommand}" CommandParameter="light" BorderThickness="0" Padding="8,4" ToolTip="Switch to Light Theme">
                                <Path Data="{StaticResource IconSun}" Fill="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" />
                            </Button>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- ========================================== -->
        <!-- MAIN SCROLLABLE CONTENT -->
        <!-- ========================================== -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="24,20">
            <StackPanel MaxWidth="800" HorizontalAlignment="Center">

                <!-- 1. HERO PREVIEW CARD -->
                <Border Style="{StaticResource CardPanel}" Background="{DynamicResource AccentSubtleBrush}" BorderBrush="{DynamicResource AccentBrush}" BorderThickness="1.5">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                <Path Data="{StaticResource IconClock}" Fill="{DynamicResource AccentBrush}" Width="16" Height="16" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="NEXT UPCOMING ANNOUNCEMENT" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                            </StackPanel>

                            <TextBlock Text="{Binding NextChimeDisplay}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,2,0,8" />

                            <Border Background="{DynamicResource WindowBackgroundBrush}" CornerRadius="6" Padding="12,8" Margin="0,2,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Path Data="{StaticResource IconVolume}" Fill="{DynamicResource TextSecondaryBrush}" Width="14" Height="14" Stretch="Uniform" Margin="0,0,8,0" VerticalAlignment="Center" />
                                    <TextBlock Text="Spoken: " FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding NextChimeSpokenPhrase}" FontSize="13" FontStyle="Italic" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <!-- Current Wall Clock -->
                        <StackPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="Current Local Time" FontSize="11" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Right" />
                            <TextBlock Text="{Binding CurrentTimeDisplay}" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- 2. SCHEDULE CONFIGURATION CARD -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="1. Schedule &amp; Interval" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

                        <!-- Frequency Segmented Picker -->
                        <TextBlock Text="Announcement Frequency" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,18">
                            <RadioButton Content="Quarter-Hourly (Every 15 min)" Style="{StaticResource SegmentedRadioButton}" IsChecked="{Binding IsQuarterHourly}" ToolTip="Announces at :00, :15, :30, :45" />
                            <RadioButton Content="Half-Hourly (Every 30 min)" Style="{StaticResource SegmentedRadioButton}" IsChecked="{Binding IsHalfHourly}" ToolTip="Announces at :00 and :30" />
                            <RadioButton Content="Hourly (Every 60 min)" Style="{StaticResource SegmentedRadioButton}" IsChecked="{Binding IsHourly}" ToolTip="Announces at :00 top of the hour" />
                        </StackPanel>

                        <!-- Daily Active Window -->
                        <TextBlock Text="Daily Active Window" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" Margin="0,0,0,8" />
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Start:" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" />
                            <TextBox Grid.Column="1" Style="{StaticResource FluentTextBox}" Text="{Binding StartTimeText, UpdateSourceTrigger=PropertyChanged}" />

                            <TextBlock Grid.Column="2" Text="End:" VerticalAlignment="Center" Foreground="{DynamicResource TextPrimaryBrush}" Margin="16,0,8,0" />
                            <TextBox Grid.Column="3" Style="{StaticResource FluentTextBox}" Text="{Binding EndTimeText, UpdateSourceTrigger=PropertyChanged}" />

                            <CheckBox Grid.Column="4" Style="{StaticResource FluentCheckBox}" Content="24 Hours / All Day" IsChecked="{Binding IsAllDay}" Margin="20,0,0,0" VerticalAlignment="Center" />
                        </Grid>

                        <!-- Overnight Rule Helper Box -->
                        <Border Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,8" Margin="0,0,0,18">
                            <TextBlock Text="* Semantics: Start is inclusive, End is exclusive. Overnight windows (e.g. 22:00–06:00) span midnight and anchor to the starting weekday." FontSize="11" Foreground="{DynamicResource TextMutedBrush}" TextWrapping="Wrap" />
                        </Border>

                        <!-- Weekday Selection Chips -->
                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0" Text="Active Weekdays" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />

                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                <Button Content="Mon–Fri Presets" Style="{StaticResource SecondaryButton}" Command="{Binding SelectWeekdaysOnlyCommand}" Margin="0,0,8,0" Padding="10,4" FontSize="11" />
                                <Button Content="All Days" Style="{StaticResource SecondaryButton}" Command="{Binding SelectAllDaysCommand}" Padding="10,4" FontSize="11" />
                            </StackPanel>
                        </Grid>

                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <CheckBox Content="M" Style="{StaticResource WeekdayChip}" IsChecked="{Binding MondayEnabled}" Margin="0,0,6,0" ToolTip="Monday" />
                            <CheckBox Content="T" Style="{StaticResource WeekdayChip}" IsChecked="{Binding TuesdayEnabled}" Margin="0,0,6,0" ToolTip="Tuesday" />
                            <CheckBox Content="W" Style="{StaticResource WeekdayChip}" IsChecked="{Binding WednesdayEnabled}" Margin="0,0,6,0" ToolTip="Wednesday" />
                            <CheckBox Content="T" Style="{StaticResource WeekdayChip}" IsChecked="{Binding ThursdayEnabled}" Margin="0,0,6,0" ToolTip="Thursday" />
                            <CheckBox Content="F" Style="{StaticResource WeekdayChip}" IsChecked="{Binding FridayEnabled}" Margin="0,0,6,0" ToolTip="Friday" />
                            <CheckBox Content="S" Style="{StaticResource WeekdayChip}" IsChecked="{Binding SaturdayEnabled}" Margin="0,0,6,0" ToolTip="Saturday" />
                            <CheckBox Content="S" Style="{StaticResource WeekdayChip}" IsChecked="{Binding SundayEnabled}" ToolTip="Sunday" />

                            <CheckBox Style="{StaticResource FluentCheckBox}" Content="Weekend Off shortcut" IsChecked="{Binding IsWeekendOff}" Margin="24,0,0,0" VerticalAlignment="Center" ToolTip="Quickly disable Saturday and Sunday" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- 3. VOICE CATALOG & PREVIEW CARD -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="2. Offline Voice Library" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" VerticalAlignment="Center" />
                            <Border Grid.Column="1" Background="{DynamicResource TagBackgroundBrush}" CornerRadius="12" Padding="10,3">
                                <TextBlock Text="10 Audited Profiles [Phase 1 Mock Mode]" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TagForegroundBrush}" />
                            </Border>
                        </Grid>

                        <!-- Search and Filter Bar -->
                        <Grid Margin="0,0,0,14">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBox Grid.Column="0" Style="{StaticResource FluentTextBox}" Text="{Binding SearchQuery, UpdateSourceTrigger=PropertyChanged}" Margin="0,0,10,0" Tag="Search voices..." />

                            <ComboBox Grid.Column="1" SelectedValue="{Binding SelectedGenderFilter}" SelectedValuePath="Content" Width="100" Margin="0,0,10,0" Height="32">
                                <ComboBoxItem Content="All" IsSelected="True" />
                                <ComboBoxItem Content="Female" />
                                <ComboBoxItem Content="Male" />
                            </ComboBox>

                            <ComboBox Grid.Column="2" SelectedValue="{Binding SelectedLocaleFilter}" SelectedValuePath="Content" Width="100" Height="32">
                                <ComboBoxItem Content="All" IsSelected="True" />
                                <ComboBoxItem Content="US" />
                                <ComboBoxItem Content="GB" />
                                <ComboBoxItem Content="AU" />
                                <ComboBoxItem Content="IN" />
                            </ComboBox>
                        </Grid>

                        <!-- Voice Cards List -->
                        <ListBox ItemsSource="{Binding FilteredVoices}" SelectedItem="{Binding SelectedVoice}" Background="Transparent" BorderThickness="0" Height="260" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border x:Name="itemBorder" Background="{DynamicResource SurfaceBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="1" CornerRadius="6" Padding="12,10" Margin="0,0,0,8">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="Auto" />
                                                        </Grid.ColumnDefinitions>

                                                        <!-- Selection Radio Indicator -->
                                                        <RadioButton Grid.Column="0" IsChecked="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=IsSelected}" VerticalAlignment="Center" Margin="0,0,12,0" Focusable="False" />

                                                        <!-- Voice Info -->
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <StackPanel Orientation="Horizontal">
                                                                <TextBlock Text="{Binding TaggedDisplayName}" FontWeight="Bold" FontSize="13" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,8,0" />
                                                                <Border Background="{DynamicResource TagBackgroundBrush}" CornerRadius="4" Padding="6,1" Margin="0,0,4,0">
                                                                    <TextBlock Text="{Binding Locale}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TagForegroundBrush}" />
                                                                </Border>
                                                                <Border Background="{DynamicResource TagBackgroundBrush}" CornerRadius="4" Padding="6,1">
                                                                    <TextBlock Text="{Binding Gender}" FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource TagForegroundBrush}" />
                                                                </Border>
                                                            </StackPanel>
                                                            <TextBlock Text="{Binding LicenseRecord}" FontSize="11" Foreground="{DynamicResource TextMutedBrush}" Margin="0,2,0,0" />
                                                        </StackPanel>

                                                        <!-- Sample Text Preview -->
                                                        <TextBlock Grid.Column="2" Text="{Binding SampleText}" FontSize="11" FontStyle="Italic" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" Margin="12,0,12,0" />

                                                        <!-- Inline Preview Button (Shows on Row Hover & Selected) -->
                                                        <Button x:Name="btnInlinePreview"
                                                                Grid.Column="3"
                                                                Style="{StaticResource PrimaryButton}"
                                                                Command="{Binding DataContext.PlayVoiceCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}"
                                                                Padding="12,6"
                                                                Visibility="Hidden"
                                                                VerticalAlignment="Center"
                                                                ToolTip="Play preview for this voice">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Path Data="{StaticResource IconPlay}" Fill="{DynamicResource AccentForegroundBrush}" Width="10" Height="10" Stretch="Uniform" Margin="0,0,5,0" VerticalAlignment="Center" />
                                                                <TextBlock Text="Preview" FontSize="11" FontWeight="SemiBold" />
                                                            </StackPanel>
                                                        </Button>
                                                    </Grid>
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                                        <Setter TargetName="btnInlinePreview" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                    <Trigger Property="IsSelected" Value="True">
                                                        <Setter TargetName="itemBorder" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                                        <Setter TargetName="itemBorder" Property="Background" Value="{DynamicResource AccentSubtleBrush}" />
                                                        <Setter TargetName="btnInlinePreview" Property="Visibility" Value="Visible" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <!-- Volume and Speech Rate Sliders -->
                        <Grid Margin="0,18,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Volume Slider -->
                            <StackPanel Grid.Column="0">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Speech Volume" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding VolumePercent, StringFormat='{}{0}%'}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider Style="{StaticResource FluentSlider}" Minimum="0" Maximum="100" Value="{Binding VolumePercent}" />
                            </StackPanel>

                            <!-- Rate Slider -->
                            <StackPanel Grid.Column="2">
                                <Grid Margin="0,0,0,4">
                                    <TextBlock Text="Speech Rate" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondaryBrush}" HorizontalAlignment="Left" />
                                    <TextBlock Text="{Binding SpeechRateDisplay}" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" HorizontalAlignment="Right" />
                                </Grid>
                                <Slider Style="{StaticResource FluentSlider}" Minimum="0.5" Maximum="2.0" Value="{Binding SpeechRate}" TickFrequency="0.1" IsSnapToTickEnabled="True" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- 4. BEHAVIOR & APPLICATION PREFERENCES -->
                <Border Style="{StaticResource CardPanel}">
                    <StackPanel>
                        <TextBlock Text="3. Application Behavior &amp; Preferences" FontSize="16" FontWeight="Bold" Foreground="{DynamicResource TextPrimaryBrush}" Margin="0,0,0,16" />

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!-- Launch at Windows Startup with User vs System Level Scope -->
                            <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,0,14">
                                <CheckBox Style="{StaticResource FluentCheckBox}" Content="Launch at Windows startup (minimized to tray)" IsChecked="{Binding LaunchAtLogin}" ToolTip="Starts automatically in the background on Windows startup" />
                                <StackPanel Orientation="Horizontal" Margin="26,6,0,0" IsEnabled="{Binding LaunchAtLogin}">
                                    <RadioButton Content="Current User only" IsChecked="{Binding IsUserStartupScope}" Style="{StaticResource FluentRadioButton}" Margin="0,0,16,0" ToolTip="Runs only when your specific Windows user logs in (HKCU Run)" />
                                    <RadioButton Content="All Users (System Level)" IsChecked="{Binding IsSystemStartupScope}" Style="{StaticResource FluentRadioButton}" ToolTip="Runs automatically for any user logged into this PC (Common Startup / HKLM)" />
                                </StackPanel>
                            </StackPanel>

                            <CheckBox Grid.Row="0" Grid.Column="1" Style="{StaticResource FluentCheckBox}" Content="Minimize to Windows System Tray on close" IsChecked="{Binding MinimizeToTray}" Margin="0,0,0,14" ToolTip="Keeps app running in Windows System Tray when window is closed (Activated in Phase 2 system tray service)" />

                            <CheckBox Grid.Row="1" Grid.Column="0" Style="{StaticResource FluentCheckBox}" Content="Play gentle bell sound before speaking time" IsChecked="{Binding BellEnabled}" ToolTip="Plays a subtle chime tone before the voice announcement" />

                            <CheckBox Grid.Row="1" Grid.Column="1" Style="{StaticResource FluentCheckBox}" Content="Use 12-Hour AM/PM Speech format" IsChecked="{Binding Is12HourFormat}" ToolTip="Uncheck to speak in 24-Hour Military format (e.g. fourteen hundred hours)" />
                        </Grid>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- ========================================== -->
        <!-- FOOTER -->
        <!-- ========================================== -->
        <Border Grid.Row="2" Background="{DynamicResource HeaderBackgroundBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="24,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconCheck}" Fill="{DynamicResource SuccessBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding SaveStatusText}" FontSize="12" Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </StackPanel>
                    <TextBlock Text="Time Chime v1.0.0-preview | Phase 1 UI Mock Edition" FontSize="10" Foreground="{DynamicResource TextMutedBrush}" Margin="18,2,0,0" />
                </StackPanel>

                <Button Grid.Column="1" Style="{StaticResource SecondaryButton}" Command="{Binding ResetDefaultsCommand}" VerticalAlignment="Center" ToolTip="Reset all settings to default values">
                    <StackPanel Orientation="Horizontal">
                        <Path Data="{StaticResource IconReset}" Fill="{DynamicResource TextSecondaryBrush}" Width="12" Height="12" Stretch="Uniform" Margin="0,0,6,0" VerticalAlignment="Center" />
                        <TextBlock Text="Reset Defaults" />
                    </StackPanel>
                </Button>
            </Grid>
        </Border>

    </Grid>
</Window>
