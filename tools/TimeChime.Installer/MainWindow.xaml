<Window x:Class="TimeChime.Installer.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Time Chime Setup"
        Width="560" Height="440"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource WindowBg}"
        FontFamily="Segoe UI Variable Display, Segoe UI, sans-serif"
        Icon="pack://application:,,,/app.ico">

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Content -->
            <RowDefinition Height="*" />
            <!-- Actions -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Header -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,20">
            <!-- App Icon -->
            <Border Width="48" Height="48" CornerRadius="12" Background="#282C3A" Margin="0,0,16,0">
                <Viewbox Width="28" Height="28">
                    <Canvas Width="24" Height="24">
                        <Path Fill="#FFD23F" Data="M12 2C8.13 2 5 5.13 5 9C5 14.25 2 16 2 16H22C22 16 19 14.25 19 9C19 5.13 15.87 2 12 2Z" />
                        <Path Fill="#E5B820" Data="M9 19C9 20.66 10.34 22 12 22C13.66 22 15 20.66 15 19H9Z" />
                    </Canvas>
                </Viewbox>
            </Border>

            <StackPanel VerticalAlignment="Center">
                <TextBlock Text="Time Chime Setup" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" />
                <TextBlock Text="Offline Spoken Clock Chime for Windows" FontSize="13" Foreground="{StaticResource TextSecondary}" Margin="0,2,0,0" />
            </StackPanel>
        </StackPanel>

        <!-- Main Body -->
        <StackPanel Grid.Row="1" VerticalAlignment="Center">
            <!-- Install Location Card -->
            <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="14" Margin="0,0,0,14">
                <StackPanel>
                    <TextBlock Text="SYSTEM INSTALLATION DIRECTORY (ALL USERS)" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextSecondary}" Margin="0,0,0,6" />
                    <TextBlock x:Name="TxtInstallPath" Text="C:\Program Files\Time Chime" FontSize="13" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>

            <!-- Options (Visible before install) -->
            <StackPanel x:Name="PnlOptions">
                <CheckBox x:Name="ChkStartMenu" Content="Create Start Menu shortcut" IsChecked="True" Style="{StaticResource FluentCheckBox}" />
                <CheckBox x:Name="ChkDesktop" Content="Create Desktop shortcut" IsChecked="True" Style="{StaticResource FluentCheckBox}" />
                <CheckBox x:Name="ChkLaunch" Content="Launch Time Chime when installation completes" IsChecked="True" Style="{StaticResource FluentCheckBox}" />
            </StackPanel>

            <!-- Progress Area (Visible during install) -->
            <StackPanel x:Name="PnlProgress" Visibility="Collapsed" Margin="0,8,0,0">
                <ProgressBar x:Name="PbInstall" Height="8" Minimum="0" Maximum="100" Value="0" Foreground="{StaticResource AccentColor}" Background="#2B2B36" BorderThickness="0" Margin="0,0,0,10" />
                <TextBlock x:Name="TxtStatus" Text="Preparing..." FontSize="12" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </StackPanel>

        <!-- Footer Actions -->
        <Grid Grid.Row="2" Margin="0,16,0,0">
            <Button x:Name="BtnCancel" Content="Cancel" Style="{StaticResource SecondaryButton}" HorizontalAlignment="Left" Click="OnCancelClick" />
            <Button x:Name="BtnInstall" Content="Install Time Chime" Style="{StaticResource AccentButton}" HorizontalAlignment="Right" Click="OnInstallClick" />
        </Grid>
    </Grid>
</Window>

